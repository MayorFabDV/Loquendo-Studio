{
  "name": "loquendo-studio",
  "version": "1.0.0",
  "description": "Loquendo Studio - Herramienta profesional de automatización de voz y edición multimedia",
  "main": "main-electron.js",
  "author": "BafYam",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/check_build_prereqs.js",
    "clean": "rmdir /s /q dist 2>nul & echo Limpiado",
    "build": "npm run clean && electron-builder",
    "build:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build_safe.ps1",
    "build:dir": "electron-builder --win dir",
    "build:portable": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bafyam.loquendo",
    "productName": "Loquendo Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main-electron.js",
      "preload.js",
      "server.js",
      "frontend/**/*",
      "backend/services/**/*",
      "backend/db/**/*",
      "!backend/public/audios/*",
      "!backend/public/pngtuber/*",
      "!backend/db/*.json",
      "!backend/bin/**/*",
      "!backend/python/**/*",
      "!backend/modules/**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin/*",
      "!**/*.{o,hprof,orig,pyc,pyo,rbc}",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}"
    ],
    "asarUnpack": [
      "backend/bin/**/*",
      "backend/modules/**/*",
      "backend/python/**/*",
      "backend/services/**/*",
      "backend/db/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/bin/",
        "to": "backend/bin/"
      },
      {
        "from": "backend/modules/",
        "to": "backend/modules/"
      },
      {
        "from": "backend/public/",
        "to": "backend/public/"
      },
      {
        "from": "backend/db/",
        "to": "backend/db/"
      },
      {
        "from": "backend/python/",
        "to": "backend/python/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/img/logo.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loquendo Studio",
      "installerIcon": "frontend/img/logo.ico",
      "uninstallerIcon": "frontend/img/logo.ico"
    },
    "portable": {
      "artifactName": "LoquendoStudio-Portable-${version}.exe"
    }
  }
}
